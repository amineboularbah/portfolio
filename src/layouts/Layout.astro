---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy } from '../data/copy';
import { projects } from '../data/projects';
import { translatedPage, type Page } from '../data/pages';
import { absolute, locales, site } from '../data/site';

interface Props {
  page: Page;
  noindex?: boolean;
}
const { page, noindex = false } = Astro.props;
const t = copy[page.locale];
const canonical = absolute(page.path);
const personId = site.url + '/#person';
const websiteId = site.url + '/#website';
const pageId = canonical + '#webpage';
const project = projects.find((item) => item.slug === page.projectSlug);
const crumbs = [
  {
    '@type': 'ListItem',
    position: 1,
    name: t.nav.home,
    item: absolute(page.locale === 'en' ? '/' : '/' + page.locale + '/'),
  },
];
if (page.section)
  crumbs.push({
    '@type': 'ListItem',
    position: 2,
    name: t.nav[page.section],
    item: absolute(
      translatedPage({ ...page, projectSlug: undefined }, page.locale).path,
    ),
  });
if (project)
  crumbs.push({
    '@type': 'ListItem',
    position: 3,
    name: project.name,
    item: canonical,
  });
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: site.url + '/',
      image: absolute('/assets/images/me.webp'),
      jobTitle: site.role,
      description: t.about.intro,
      email: site.email,
      homeLocation: { '@type': 'Place', name: site.city },
      knowsAbout: [
        'Flutter',
        'Dart',
        'Mobile application development',
        'iOS',
        'Android',
        'Mobile architecture',
        'Technical leadership',
      ],
      sameAs: site.profiles.map((profile) => profile.url),
      worksFor: { '@id': site.studio + '/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': site.studio + '/#organization',
      name: 'AppWrapp LLC',
      url: site.studio + '/',
      founder: { '@id': personId },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: site.url + '/',
      name: site.name,
      publisher: { '@id': personId },
      inLanguage: locales,
    },
    {
      '@type':
        page.section === 'about' || page.section === ''
          ? 'ProfilePage'
          : 'WebPage',
      '@id': pageId,
      url: canonical,
      name: page.title,
      description: page.description,
      inLanguage: page.locale,
      isPartOf: { '@id': websiteId },
      ...(page.section === 'about' || page.section === ''
        ? { mainEntity: { '@id': personId } }
        : {}),
      ...(page.section
        ? { breadcrumb: { '@id': canonical + '#breadcrumb' } }
        : {}),
    },
    ...(page.section
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': canonical + '#breadcrumb',
            itemListElement: crumbs,
          },
        ]
      : []),
    ...(page.section === 'services'
      ? [
          {
            '@type': 'Service',
            '@id': canonical + '#service',
            name: 'Mobile app development and engineering',
            provider: { '@id': personId },
            url: canonical,
            description: t.services.intro,
            areaServed: 'Worldwide, remotely',
            serviceType: [
              'Flutter development',
              'Mobile architecture',
              'Native integrations',
              'Technical leadership',
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={page.locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('ab-theme') === 'dark')
            document.documentElement.dataset.theme = 'dark';
        } catch {
          /* The light default also works when storage is unavailable. */
        }
      })();
    </script>
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((locale) => (
          <link
            rel="alternate"
            hreflang={locale}
            href={absolute(translatedPage(page, locale).path)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(translatedPage(page, 'en').path)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:locale"
      content={{ en: 'en_GB', fr: 'fr_FR', es: 'es_ES' }[page.locale]}
    />
    <meta property="og:image" content={absolute('/social-card.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Amine Boularbah. Lead Mobile Engineer & Founder. Málaga, Spain."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={absolute('/social-card.png')} />
    <meta name="theme-color" content="#fafaf6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(graph).replace(/</g, '\u003c')}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <Header page={page} noindex={noindex} />
    <main id="main">
      {page.section && !noindex && (
        <nav
          class="container breadcrumbs"
          aria-label={
            page.locale === 'fr'
              ? 'Fil d’Ariane'
              : page.locale === 'es'
                ? 'Ruta de navegación'
                : 'Breadcrumb'
          }
        >
          <ol>
            {crumbs.map((crumb, index) => (
              <li>
                {index === crumbs.length - 1 ? (
                  <span aria-current="page">{crumb.name}</span>
                ) : (
                  <a href={crumb.item}>{crumb.name}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer locale={page.locale} />
    <script>
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.animate(
                [
                  { opacity: 0, transform: 'translateY(18px)' },
                  { opacity: 1, transform: 'translateY(0)' },
                ],
                { duration: 650, easing: 'cubic-bezier(.2,.65,.3,1)' },
              );
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08 },
        );
        document
          .querySelectorAll('[data-reveal]')
          .forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
