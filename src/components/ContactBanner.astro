---
import { copy } from '../data/copy';
import { localPath, type Locale } from '../data/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="contact-banner" id="contact">
  <div class="container contact-banner-inner" data-reveal>
    <div>
      <p class="eyebrow">{t.cta.eyebrow}</p>
      <h2>{t.cta.title}</h2>
      <p class="muted">{t.cta.body}</p>
    </div>
    <a class="button button-dark" href={localPath(locale, 'contact')}>
      {t.cta.button}
    </a>
  </div>
</section>
