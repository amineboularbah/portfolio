---
import { Image } from 'astro:assets';
import portrait from '../assets/me.webp';
import { copy } from '../data/copy';
import { experience, credentials } from '../data/experience';
import { site, type Locale } from '../data/site';
import ContactBanner from './ContactBanner.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="container page-intro">
  <p class="eyebrow">{t.about.eyebrow}</p>
  <h1>{t.about.title}</h1>
  <p class="intro">{t.about.intro}</p>
</section>
<section class="container about-story" data-reveal>
  <figure>
    <Image
      src={portrait}
      alt={t.ui.photo}
      widths={[400, 640, 880]}
      sizes="(max-width:760px) 90vw, 400px"
      format="webp"
      loading="eager"
    />
    <figcaption>{t.ui.portraitCaption}</figcaption>
  </figure>
  <div>
    <h2>{t.about.heading}</h2>
    {t.about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <ul class="principles">
      {t.about.approach.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>
<section class="container section experience-section" id="experience">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">{t.about.timelineLabel}</p>
      <h2>{t.about.timelineTitle}</h2>
    </div>
  </div>
  <ol class="timeline">
    {experience.map((item) => (
      <li data-reveal>
        <span class="timeline-period">{item.period[locale]}</span>
        <div>
          <h3>{item.role[locale]}</h3>
          {item.url ? (
            <a
              class="company-name"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.company}
            </a>
          ) : (
            <span class="company-name">{item.company}</span>
          )}
          <p>{item.description[locale]}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<section class="credentials-section" id="credentials">
  <div class="container" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.about.referencesLabel}</p>
        <h2>{t.about.referencesTitle}</h2>
      </div>
      <p>{t.about.referencesIntro}</p>
    </div>
    <div class="credential-grid">
      {credentials.map((credential) => (
        <article>
          <p class="caption">
            {credential.issuer} / {credential.year}
          </p>
          <h3>{t.about[credential.key]}</h3>
          <a
            class="text-link"
            href={credential.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.ui.credentials}
          </a>
        </article>
      ))}
    </div>
    <div class="profile-links">
      <p>{t.ui.profiles}</p>
      {site.profiles.map((profile) => (
        <a
          class="text-link"
          href={profile.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {profile.label}
        </a>
      ))}
    </div>
  </div>
</section>
<ContactBanner locale={locale} />
