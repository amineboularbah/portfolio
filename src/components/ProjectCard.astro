---
import { Image } from 'astro:assets';
import { copy } from '../data/copy';
import type { Project } from '../data/projects';
import { localPath, type Locale } from '../data/site';
interface Props {
  project: Project;
  locale: Locale;
  index: number;
}
const { project, locale, index } = Astro.props;
const t = copy[locale];
const content = project.content[locale];
const href = localPath(locale, 'projects/' + project.slug);
---

<article class="project-card" data-category={project.category} data-reveal>
  <a
    class:list={['project-visual', project.visual, project.slug]}
    style={'--project-bg:' + project.color}
    href={href}
    aria-label={project.name + ': ' + t.ui.read}
  >
    <span class="project-index" aria-hidden="true">
      0{index + 1}
    </span>
    <Image
      src={project.image}
      alt={project.name}
      widths={project.visual === 'screen' ? [320, 480, 640] : [480, 800, 1200]}
      sizes={
        project.visual === 'screen'
          ? '(max-width: 760px) 220px, 260px'
          : '(max-width: 760px) 90vw, 560px'
      }
      format="webp"
      loading="lazy"
    />
    <span class="visual-label">{project.name}</span>
  </a>
  <div class="project-heading">
    <h3>
      <a href={href}>{project.name}</a>
    </h3>
    <span class="category-label">{t.ui[project.category]}</span>
  </div>
  <p>{content.summary}</p>
  <div class="project-bottom">
    <span>{content.role}</span>
    <a class="text-link" href={href}>
      {t.ui.read}
    </a>
  </div>
</article>
