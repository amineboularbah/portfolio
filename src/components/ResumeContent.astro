---
import { Content as English } from '../content/resume.md';
import { Content as French } from '../content/resume.fr.md';
import { Content as Spanish } from '../content/resume.es.md';
import checksums from '../../scripts/resume-manifest.json';
import { copy } from '../data/copy';
import { site, type Locale } from '../data/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale].resume;
const Content = { en: English, fr: French, es: Spanish }[locale];
const resume = site.resume.languages[locale];
const basePath = site.resume.basePath + resume.suffix;
const manifest: Record<string, string> = checksums;
const downloads = [
  { extension: 'pdf', label: t.download, type: 'application/pdf' },
  {
    extension: 'docx',
    label: t.word,
    type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  },
  { extension: 'txt', label: t.text, type: 'text/plain' },
] as const;
---

<section class="container resume-page">
  <p class="eyebrow">{t.label}</p>
  <div class="resume-grid">
    <aside class="resume-downloads" aria-label={t.downloads}>
      <p class="resume-download-title">{t.downloads}</p>
      <p class="resume-language">{t.language}</p>
      <div class="resume-download-buttons">
        {downloads.map(({ extension, label, type }) => (
          <a
            class:list={[
              'button',
              extension === 'pdf' ? 'button-dark' : 'button-outline',
            ]}
            href={`${basePath}.${extension}?v=${manifest[`public${basePath}.${extension}`].slice(0, 12)}`}
            type={type}
            hreflang={locale}
            download={`${resume.downloadName}.${extension}`}
          >
            {label}
          </a>
        ))}
      </div>
    </aside>
    <article
      class="resume-document"
      lang={locale}
      aria-labelledby="amine-boularbah"
    >
      <Content />
    </article>
  </div>
</section>
