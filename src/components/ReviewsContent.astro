---
import { copy } from '../data/copy';
import { reviews, reviewSources } from '../data/reviews';
import type { Locale } from '../data/site';
import ContactBanner from './ContactBanner.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="container page-intro reviews-intro">
  <p class="eyebrow">{t.reviews.eyebrow}</p>
  <h1>{t.reviews.title}</h1>
  <p class="intro">{t.reviews.intro}</p>
  <a
    class="reviews-badge"
    href={reviewSources.upwork}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="status-dot" aria-hidden="true"></span>
    {t.reviews.topRated}
  </a>
</section>
{(['upwork', 'linkedin'] as const).map((source) => (
  <section
    class="container reviews-section"
    aria-labelledby={`reviews-${source}`}
  >
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{source === 'upwork' ? 'UPWORK' : 'LINKEDIN'}</p>
        <h2 id={`reviews-${source}`}>{t.reviews[source]}</h2>
      </div>
    </div>
    <div class="reviews-grid">
      {reviews
        .filter((review) => review.source === source)
        .map((review) => (
          <article class="review-card" data-reveal>
            <blockquote lang={review.language}>“{review.quote}”</blockquote>
            <div class="review-meta">
              <p class="review-person">
                {review.person ?? t.reviews.anonymous}
              </p>
              <p class="caption">{review.context}</p>
            </div>
            <a
              class="text-link"
              href={reviewSources[source]}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.reviews.source}
            </a>
          </article>
        ))}
    </div>
  </section>
))}
<p class="container reviews-note caption">{t.reviews.note}</p>
<ContactBanner locale={locale} />
